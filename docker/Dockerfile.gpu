# ==========================================
# Base Environment
# ==========================================
FROM nvidia/cuda:13.3.1-devel-ubuntu24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    curl \
    git \
    gnupg2 \
    libomp-dev \
    lsb-release \
    ninja-build \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    liburdfdom-dev \
    libentt-dev \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/apt/keyrings && \
    curl http://robotpkg.openrobots.org/packages/debian/robotpkg.asc | tee /etc/apt/keyrings/robotpkg.asc && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/robotpkg.asc] http://robotpkg.openrobots.org/packages/debian/pub $(lsb_release -cs) robotpkg" | tee /etc/apt/sources.list.d/robotpkg.list

RUN apt-get update && apt-get install -y \
    robotpkg-eigen3 \
    robotpkg-coal \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/openrobots/bin:$PATH
ENV PKG_CONFIG_PATH=/opt/openrobots/lib/pkgconfig:$PKG_CONFIG_PATH
ENV LD_LIBRARY_PATH=/opt/openrobots/lib:$LD_LIBRARY_PATH
ENV CMAKE_PREFIX_PATH=/opt/openrobots:$CMAKE_PREFIX_PATH

ENV VENV=/opt/venv
RUN python3 -m venv $VENV
ENV PATH="$VENV/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir scikit-build-core nanobind numpy torch

WORKDIR /krlsim

# ==========================================
# Builder Stage
# ==========================================
FROM base AS builder
COPY . /krlsim/
RUN pip install --no-cache-dir .

# ==========================================
# Development Stage
# ==========================================
FROM base AS dev
CMD ["/bin/bash"]

